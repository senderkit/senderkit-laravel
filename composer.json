{
  "name": "senderkit/senderkit-laravel",
  "description": "Laravel integration for the SenderKit PHP SDK — service provider, facade, mail transport, notification channel, webhook middleware.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://senderkit.com",
  "require": {
    "php": ">=8.1",
    "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
    "illuminate/mail": "^10.0 || ^11.0 || ^12.0",
    "illuminate/notifications": "^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "senderkit/senderkit-php": "^0.1 || ^0.2 || ^0.3"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.8",
    "orchestra/testbench": "^8.22 || ^9.0 || ^10.0"
  },
  "autoload": { "psr-4": { "SenderKit\\Laravel\\": "src/" } },
  "autoload-dev": { "psr-4": { "SenderKit\\Laravel\\Tests\\": "tests/" } },
  "extra": {
    "laravel": {
      "providers": ["SenderKit\\Laravel\\SenderKitServiceProvider"],
      "aliases": { "SenderKit": "SenderKit\\Laravel\\Facades\\SenderKit" }
    }
  },
  "config": { "allow-plugins": { "php-http/discovery": true } }
}
